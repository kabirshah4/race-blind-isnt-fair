# Cloudflare Pages caching. Data files can change on redeploy, so they revalidate after an hour.
/models.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/lenders.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/FairView-Demo.mp4
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
